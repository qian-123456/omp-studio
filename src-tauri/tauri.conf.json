{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "omp-workspace",
	"version": "0.1.1",
	"identifier": "ai.omp.workspace",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1421",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"macOSPrivateApi": true,
		"windows": [
			{
				"label": "main",
				"title": "omp-workspace",
				"width": 1440,
				"height": 900,
				"minWidth": 760,
				"minHeight": 480,
				"titleBarStyle": "Overlay",
				"hiddenTitle": true
			}
		],
		"security": {
			"csp": null,
			"assetProtocol": {
				"enable": true,
				"scope": ["$HOME/.omp/agent/blobs/**", "$APPCACHE/ompws-clip/**", "$HOME/.omp-workspace/images/**"]
			}
		}
	},
	"bundle": {
		"active": true,
		"createUpdaterArtifacts": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFEOEJDNUFBRUJBRTNCRkEKUldUNk82N3Jxc1dMcmZtQzRucWpQaHRmY3NEUEthaHRHRitPT2VuazUvVytGbFczS1RqSGRFc2QK",
			"endpoints": [
				"https://github.com/qian-123456/omp-studio/releases/latest/download/latest.json"
			]
		}
	}
}
