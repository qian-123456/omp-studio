{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "omp-workspace",
	"version": "0.1.0",
	"identifier": "ai.omp.workspace",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1421",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"macOSPrivateApi": true,
		"windows": [
			{
				"label": "main",
				"title": "omp-workspace",
				"width": 1440,
				"height": 900,
				"minWidth": 1100,
				"minHeight": 700,
				"titleBarStyle": "Overlay",
				"hiddenTitle": true
			}
		],
		"security": {
			"csp": null,
			"assetProtocol": {
				"enable": true,
				"scope": ["$HOME/.omp/agent/blobs/**", "$APPCACHE/ompws-clip/**"]
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
