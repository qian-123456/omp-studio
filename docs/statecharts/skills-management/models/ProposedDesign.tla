---- MODULE ProposedDesign ----
\* Generated by chart-to-tla.mjs from proposed-flow.mmd.
\* Each region is one variable and each transition label is one action.
\* Once you add guards and variables from the real code, this file is the source.
\* statechart.mjs from-chart proposed-flow.mmd keeps it, checks it, and compares it with the chart.

VARIABLES Step, Step2
vars == <<Step, Step2>>

\* Region 安装与移除
StepStates == {"Remaining", "Installed", "Removed", "Checking", "Removing", "Unknown", "Choosing"}
\* Region 操作反馈
Step2States == {"Partial", "Done", "Pending", "Idle", "NeedRefresh", "Failed"}

TypeOK ==
    /\ Step \in StepStates
    /\ Step2 \in Step2States

Init ==
    /\ Step = "Installed"
    /\ Step2 = "Idle"

\* 点击移除
Step3 ==
    /\ Step \in {"Installed", "Remaining"}
    /\ (Step \in {"Installed", "Remaining"} \/ Step2 \in {"Partial", "Failed"})
    /\ \/ (Step = "Installed" /\ Step' = "Choosing")
       \/ (Step = "Remaining" /\ Step' = "Choosing")
       \/ (Step \notin {"Installed", "Remaining"} /\ UNCHANGED Step)
    /\ \/ (Step2 = "Partial" /\ Step2' = "Idle")
       \/ (Step2 = "Failed" /\ Step2' = "Idle")
       \/ (Step2 \notin {"Partial", "Failed"} /\ UNCHANGED Step2)

\* 取消
Step4 ==
    /\ \/ (Step = "Choosing" /\ Step' = "Installed")
    /\ UNCHANGED <<Step2>>

\* 确认移除所选位置
Step5 ==
    /\ Step = "Choosing"
    /\ (Step \in {"Choosing"} \/ Step2 \in {"Idle"})
    /\ \/ (Step = "Choosing" /\ Step' = "Removing")
       \/ (Step \notin {"Choosing"} /\ UNCHANGED Step)
    /\ \/ (Step2 = "Idle" /\ Step2' = "Pending")
       \/ (Step2 \notin {"Idle"} /\ UNCHANGED Step2)

\* 所选副本已移到废纸篓
Step6 ==
    /\ \/ (Step = "Removing" /\ Step' = "Checking")
    /\ UNCHANGED <<Step2>>

\* 移除失败且文件未变
Step7 ==
    /\ Step = "Removing"
    /\ (Step \in {"Removing"} \/ Step2 \in {"Pending"})
    /\ \/ (Step = "Removing" /\ Step' = "Installed")
       \/ (Step \notin {"Removing"} /\ UNCHANGED Step)
    /\ \/ (Step2 = "Pending" /\ Step2' = "Failed")
       \/ (Step2 \notin {"Pending"} /\ UNCHANGED Step2)

\* 部分移除失败并列出结果
Step8 ==
    /\ Step = "Removing"
    /\ (Step \in {"Removing"} \/ Step2 \in {"Pending"})
    /\ \/ (Step = "Removing" /\ Step' = "Remaining")
       \/ (Step \notin {"Removing"} /\ UNCHANGED Step)
    /\ \/ (Step2 = "Pending" /\ Step2' = "Partial")
       \/ (Step2 \notin {"Pending"} /\ UNCHANGED Step2)

\* 扫描确认已无副本
Step9 ==
    /\ Step = "Checking"
    /\ (Step \in {"Checking"} \/ Step2 \in {"Pending"})
    /\ \/ (Step = "Checking" /\ Step' = "Removed")
       \/ (Step \notin {"Checking"} /\ UNCHANGED Step)
    /\ \/ (Step2 = "Pending" /\ Step2' = "Done")
       \/ (Step2 \notin {"Pending"} /\ UNCHANGED Step2)

\* 扫描确认仍有副本
Step10 ==
    /\ Step = "Checking"
    /\ (Step \in {"Checking"} \/ Step2 \in {"Pending"})
    /\ \/ (Step = "Checking" /\ Step' = "Remaining")
       \/ (Step \notin {"Checking"} /\ UNCHANGED Step)
    /\ \/ (Step2 = "Pending" /\ Step2' = "Partial")
       \/ (Step2 \notin {"Pending"} /\ UNCHANGED Step2)

\* 扫描失败
Step11 ==
    /\ Step = "Checking"
    /\ (Step \in {"Checking"} \/ Step2 \in {"Pending"})
    /\ \/ (Step = "Checking" /\ Step' = "Unknown")
       \/ (Step \notin {"Checking"} /\ UNCHANGED Step)
    /\ \/ (Step2 = "Pending" /\ Step2' = "NeedRefresh")
       \/ (Step2 \notin {"Pending"} /\ UNCHANGED Step2)

\* 点击重新核对
Step12 ==
    /\ Step = "Unknown"
    /\ (Step \in {"Unknown"} \/ Step2 \in {"NeedRefresh"})
    /\ \/ (Step = "Unknown" /\ Step' = "Checking")
       \/ (Step \notin {"Unknown"} /\ UNCHANGED Step)
    /\ \/ (Step2 = "NeedRefresh" /\ Step2' = "Pending")
       \/ (Step2 \notin {"NeedRefresh"} /\ UNCHANGED Step2)

Next == Step3 \/ Step4 \/ Step5 \/ Step6 \/ Step7 \/ Step8 \/ Step9 \/ Step10 \/ Step11 \/ Step12

Spec == Init /\ [][Next]_vars

\* 仍有副本时不能宣告全部移除完成。
NoFalseCompletion == ~(Step = "Remaining" /\ Step2 = "Done")

\* 未核对剩余位置时不能宣告全部移除完成。
NoUnknownCompletion == ~(Step = "Unknown" /\ Step2 = "Done")

\* 文件仍在移除过程中时不能宣告全部移除完成。
NoEarlyCompletion == ~(Step = "Removing" /\ Step2 = "Done")

====
