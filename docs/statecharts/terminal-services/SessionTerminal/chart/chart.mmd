---
title: "会话终端登记表"
config:
  markdownAutoWrap: false
  state:
    useMaxWidth: false
---
stateDiagram-v2
  classDef plainWrong fill:#f4f6f7,stroke:#c0392b,stroke-width:4px,color:#7b241c
  classDef group0 fill:#d1f2eb,stroke:#697976,color:#1b2631
  classDef group1 fill:#ffffff,stroke:#808080,color:#1b2631
  classDef group2 fill:#d6eaf8,stroke:#6b757c,color:#1b2631
  classDef group2Wrong fill:#d6eaf8,stroke:#c0392b,stroke-width:4px,color:#7b241c
  classDef group3 fill:#fdebd0,stroke:#7f7668,color:#1b2631
  classDef group3Wrong fill:#fdebd0,stroke:#c0392b,stroke-width:4px,color:#7b241c
  state "Legend" as legend {
    state "终端运行中" as legendGroup0
    state "无终端" as legendGroup1
    state "会话已删除仍有终端" as legendGroup2
    state "终端已结束却仍被登记" as legendGroup3
    state "违反规则" as legendWrong
  }
  class legendGroup0 group0
  class legendGroup1 group1
  class legendGroup2 group2
  class legendGroup3 group3
  class legendWrong plainWrong
  state "会话存在，没有终端进程，登记表为空" as s0
  state "会话存在，终端进程在运行，登记表认为终端打开" as s1
  state "会话存在，终端进程在运行，终端刚启动，尚未登记，登记表为空" as s2
  state "会话存在，终端进程已结束，登记表为空" as s3
  state "会话存在，终端进程已结束，登记表认为终端打开" as s4
  state "会话存在，终端进程已结束，终端刚启动，尚未登记，登记表为空" as s5
  state "会话已删除，没有终端进程，登记表为空" as s6
  state "会话已删除，终端进程在运行，登记表认为终端打开" as s7
  state "会话已删除，终端进程在运行，终端刚启动，尚未登记，登记表为空" as s8
  state "会话已删除，终端进程已结束，登记表为空" as s9
  state "会话已删除，终端进程已结束，登记表认为终端打开" as s10
  state "会话已删除，终端进程已结束，终端刚启动，尚未登记，登记表为空" as s11
  [*] --> s0
  s0 --> s2 : 打开会话终端
  s0 --> s6 : 删除会话
  s2 --> s5 : 终端里的 omp 退出
  s2 --> s8 : 删除会话
  s2 --> s1 : 后端把终端写入登记表
  s5 --> s11 : 删除会话
  s5 --> s4 : 后端把终端写入登记表
  s8 --> s11 : 终端里的 omp 退出
  s8 --> s7 : 后端把终端写入登记表
  s1 --> s2 : 打开会话终端
  s1 --> s3 : 终端里的 omp 退出
  s1 --> s0 : 关闭终端
  s1 --> s6 : 删除会话
  s11 --> s10 : 后端把终端写入登记表
  s4 --> s2 : 打开会话终端
  s4 --> s0 : 关闭终端
  s4 --> s6 : 删除会话
  s7 --> s9 : 终端里的 omp 退出
  s7 --> s6 : 关闭终端
  s3 --> s2 : 打开会话终端
  s3 --> s9 : 删除会话
  s10 --> s6 : 关闭终端
  class s0 group1
  class s1 group0
  class s2 group0
  class s3 group1
  class s4 group3Wrong
  class s5 group1
  class s6 group1
  class s7 group2Wrong
  class s8 group2
  class s9 group1
  class s10 group3Wrong
  class s11 group1
