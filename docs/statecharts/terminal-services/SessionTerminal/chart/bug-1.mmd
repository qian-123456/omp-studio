  classDef group2Path fill:#d6eaf8,stroke:#1f3a93,stroke-width:4px,color:#1b2631
  state "Legend" as legend {
    state "终端运行中" as legendGroup0
    state "无终端" as legendGroup1
    state "会话已删除仍有终端" as legendGroup2
    state "违反规则" as legendWrong
