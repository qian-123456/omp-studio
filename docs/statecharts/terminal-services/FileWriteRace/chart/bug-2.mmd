  class legendGroup2 group2
  class legendWrong plainWrong
  state "第一次保存尚未开始，第二次保存尚未开始，文件仍是旧内容" as s0
  state "第一次保存已写好临时文件，第二次保存尚未开始，文件仍是旧内容" as s1
  state "第一次保存已写好临时文件，第二次保存已写好临时文件，文件仍是旧内容" as s2
