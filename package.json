{
	"name": "omp-workspace",
	"private": true,
	"version": "0.1.2",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"dev:mobile": "vite build --config vite.mobile.config.ts --watch",
		"build:mobile": "vite build --config vite.mobile.config.ts",
		"dev:preview": "VITE_PORT=1425 OMPWS_DATA_DIR=$HOME/.omp-workspace-dev tauri dev -c '{\"build\":{\"devUrl\":\"http://localhost:1425\"}}'",
		"build": "tsc --noEmit && pnpm build:mobile && vite build",
		"build:app": "tsc --noEmit && pnpm build:mobile && vite build && tauri build",
		"preview": "vite preview",
		"guide:build": "node site/guide/build.mjs",
		"test": "vitest run",
		"tauri": "tauri"
	},
	"dependencies": {
		"@codemirror/lang-markdown": "^6.3.4",
		"@tanstack/react-virtual": "^3.13.12",
		"@tauri-apps/api": "~2.12.4",
		"@tauri-apps/plugin-clipboard-manager": "^2.3.0",
		"@tauri-apps/plugin-dialog": "^2.4.0",
		"@tauri-apps/plugin-global-shortcut": "^2.3.1",
		"@tauri-apps/plugin-notification": "^2.3.1",
		"@tauri-apps/plugin-opener": "^2.5.0",
		"@tauri-apps/plugin-process": "~2.4.0",
		"@tauri-apps/plugin-updater": "~2.12.0",
		"@uiw/react-codemirror": "^4.25.2",
		"@xterm/addon-fit": "^0.10.0",
		"@xterm/addon-search": "0.16.0",
		"@xterm/xterm": "^5.5.0",
		"clsx": "^2.1.1",
		"highlight.js": "^11.11.1",
		"html-to-image": "1.11.13",
		"katex": "0.16.22",
		"lucide-react": "^0.544.0",
		"mermaid": "11.12.0",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"react-markdown": "^10.1.0",
		"rehype-highlight": "^7.0.2",
		"rehype-katex": "7.0.1",
		"rehype-raw": "7.0.0",
		"rehype-sanitize": "6.0.0",
		"remark-cjk-friendly": "2.3.2",
		"remark-gfm": "^4.0.1",
		"remark-math": "6.0.0",
		"yaml": "2.9.1",
		"zustand": "^5.0.6"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.1.12",
		"@tauri-apps/cli": "~2.12.4",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^26.6.5",
		"@types/react": "^19.1.10",
		"@types/react-dom": "^19.1.7",
		"@vitejs/plugin-react": "^4.7.0",
		"jsdom": "^30.1.2",
		"tailwindcss": "^4.1.12",
		"typescript": "^5.9.2",
		"vite": "^6.3.5",
		"vitest": "^3.2.4"
	}
}
